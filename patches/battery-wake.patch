 #define BATTERY_PIN          (17)
 #define ADC_RESOLUTION       12
 
+// Power management (only active with -D NRF52_POWER_MANAGEMENT)
+// Won't boot below this voltage (mV); the node sleeps in SYSTEMOFF instead.
+#define PWRMGT_VOLTAGE_BOOTLOCK 3300
+// LPCOMP wake: battery on P0.31 = AIN7 through a 2:1 divider.
+// REFSEL 12 = 9/16 VDD (3.3 V) -> wakes at VBAT ~ 3.7 V (plus hysteresis).
+// 5/8 would need ~4.1 V, too high to reach on a battery.
+#define PWRMGT_LPCOMP_AIN 7
+#define PWRMGT_LPCOMP_REFSEL 12
+
